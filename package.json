{
  "name": "@jasonbelmonti/markdown-context",
  "version": "0.1.0",
  "description": "CLI-first context link scanner, validator, and resolver for Markdown.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "markdown-context": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run \"--exclude=.worktrees/**\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@jasonbelmonti/markdown-engine": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
